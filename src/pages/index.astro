---
import Layout from '../layouts/Layout.astro';
import TrackSelector from '../components/TrackSelector.astro';
---

<Layout title="Inicio">
  <h1>Taller de Servidores</h1>

  <p class="intro">
    Este taller documenta la instalación y configuración de servidores de red,
    con implementaciones tanto en <strong>Windows Server 2012 R2</strong> como en
    <strong>Linux Server (Debian)</strong>.
  </p>

  <h2>Selecciona tu Taller</h2>

  <TrackSelector />

  <h2>Arquitectura de la Solución</h2>

  <img
    src="/images/diagrama-red.png"
    alt="Arquitectura de la red"
    class="diagram-image"
  />

  <h2>Datos del Servidor</h2>

  <table class="info-table">
    <tr>
      <td>Dirección IP</td>
      <td>192.168.3.1</td>
    </tr>
    <tr>
      <td>Máscara de subred</td>
      <td>255.255.255.0</td>
    </tr>
    <tr>
      <td>Dominio DNS</td>
      <td>sebastianlizarazo.com.co</td>
    </tr>
    <tr>
      <td>Usuarios FTP/SMTP</td>
      <td>sebastian, david</td>
    </tr>
  </table>
</Layout>

<style>
  .intro {
    font-size: 1.1rem;
    color: var(--text-secondary);
    margin-bottom: 2rem;
  }

  .diagram-image {
    width: 100%;
    max-width: 700px;
    display: block;
    margin: 2rem auto;
    border-radius: 12px;
    border: 1px solid var(--border-color);
    box-shadow: var(--shadow);
  }
</style>
