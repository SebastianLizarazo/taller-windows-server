    title: "Configuración SMTP",
    icon: "✉️",
    items: [
      // =========================================
      // AGREGAR IMÁGENES DE SMTP AQUÍ
      // =========================================
      {image: "/images/smtp/AgregarCaracterista-ServidorSMTP.png", caption: "Agregar característica de servidor SMTP" },
      {image: "/images/smtp/IniciacionServicioSMTP-EnServidor.png", caption: "Iniciación del servicio SMTP en el servidor" },
      {image: "/images/smtp/ConfiguracionDominioLoca-SMTP.png", caption: "Configuración del dominio local para SMTP" },
      {image: "/images/smtp/CreacionBuzones-sebastian-david-SMTP.png", caption: "Creación de buzones de correo para los usuarios (sebastian y david)" },
      {image: "/images/smtp/AsignacionPermisosBuzonesSMTP.png", caption: "Asignación de permisos a los buzones de correo (sebastian y david)" },
