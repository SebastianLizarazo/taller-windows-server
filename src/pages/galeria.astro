---

<Layout title="Galería de Evidencias">
  <h1>Galería de Evidencias</h1>

  <p class="intro">
    Documentación visual del proceso de instalación y configuración del servidor
    Windows Server 2012 R2. Cada sección contiene las capturas de pantalla
    correspondientes a cada etapa del taller.
  </p>

  <div class="gallery-sections">
    {sections.map((section) => (
      <div class="gallery-section" id={section.id}>
        <button class="section-toggle" type="button">
          <span class="section-icon">{section.icon}</span>
          <span class="section-title">{section.title}</span>
          <span class="section-count">{section.items.length} imágenes</span>
          <span class="toggle-arrow">▼</span>
        </button>

        <div class="section-content">
          <div class="images-grid">
            {section.items.map((item, index) => (
              <div class="image-card">
                <div class="image-wrapper">
                  <img 
                    src={item.image} 
                    alt={item.caption || `${section.title} - Imagen ${index + 1}`}
                    onerror="this.parentElement.innerHTML='<div class=\\'image-placeholder\\'>📷<span>Imagen no encontrada</span></div>'"
                  />
                </div>
                <p class="image-caption">{item.caption || `${section.title} - Imagen ${index + 1}`}</p>
              </div>
            ))}
          </div>

          {section.items.length === 0 && (
            <p class="empty-message">📷 No hay imágenes disponibles para esta sección aún.</p>
          )}
        </div>
      </div>
    ))}
  </div>

  <div class="nav-buttons">
    <a href="/" class="btn">← Volver a Inicio</a>
    <a href="/dns" class="btn">Siguiente: DNS →</a>
  </div>
</Layout>

<style>
  .intro {
    color: var(--text-secondary);
    margin-bottom: 2rem;
    font-size: 1.05rem;
  }

  .gallery-sections {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .gallery-section {
    border: 1px solid var(--border-color);
    border-radius: 12px;
    overflow: hidden;
    background: var(--bg-card);
  }

  .section-toggle {
    width: 100%;
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1.25rem 1.5rem;
    background: transparent;
    border: none;
    color: var(--text-primary);
    font-size: 1rem;
    font-weight: 600;
    cursor: pointer;
    transition: background 0.3s ease;
    text-align: left;
  }

  .section-toggle:hover {
    background: rgba(108, 92, 231, 0.1);
  }

  .section-icon {
    font-size: 1.5rem;
  }

  .section-title {
    flex: 1;
  }

  .section-count {
    font-size: 0.85rem;
    color: var(--text-muted);
    font-weight: 400;
  }

  .toggle-arrow {
    font-size: 0.8rem;
    color: var(--text-muted);
    transition: transform 0.3s ease;
  }

  .section-toggle.active .toggle-arrow {
    transform: rotate(180deg);
  }

  .section-content {
    display: none;
    padding: 1.5rem;
    background: var(--bg-primary);
    border-top: 1px solid var(--border-color);
  }

  .section-content.open {
    display: block;
  }

  .images-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1.5rem;
  }

  .image-card {
    background: var(--bg-secondary);
    border: 1px solid var(--border-color);
    border-radius: 10px;
    overflow: hidden;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .image-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 8px 25px rgba(0, 0, 0, 0.3);
  }

  .image-wrapper {
    aspect-ratio: 16 / 9;
    background: var(--bg-card);
    overflow: hidden;
  }

  .image-wrapper img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .image-placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    color: var(--text-muted);
    font-size: 2rem;
  }

  .image-placeholder span {
    font-size: 0.85rem;
  }

  .image-caption {
    padding: 1rem;
    color: var(--text-secondary);
    font-size: 0.9rem;
    margin: 0;
    border-top: 1px solid var(--border-color);
    background: var(--bg-secondary);
    line-height: 1.5;
  }

  .empty-message {
    text-align: center;
    color: var(--text-muted);
    padding: 2rem;
    background: var(--bg-card);
    border-radius: 8px;
  }

  @media (max-width: 768px) {
    .images-grid {
      grid-template-columns: 1fr;
    }

    .section-toggle {
      flex-wrap: wrap;
    }

    .section-count {
      width: 100%;
      order: 3;
      margin-top: 0.5rem;
    }
  }
</style>

<script>
  document.querySelectorAll('.section-toggle').forEach(button => {
    button.addEventListener('click', () => {
      button.classList.toggle('active');
      const content = button.nextElementSibling;
      if (content) {
        content.classList.toggle('open');
      }
    });
  });
</script>
