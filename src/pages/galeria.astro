---
import Layout from '../layouts/Layout.astro';

/*
 * ================================================
 * INSTRUCCIONES PARA AGREGAR IMÁGENES
 * ================================================
 *
 * 1. Guardá tus capturas en:
 *    public/images/NOMBRE_SECCION/
 *    Ejemplo: public/images/dns/pantallazo1.png
 *
 * 2. Agregá cada imagen en la sección corresponding:
 *    { image: "/images/dns/pantallazo1.png", caption: "Descripción de lo que muestra" }
 *
 * 3. Repetí para cada imagen de la sección
 *
 * ================================================
 */

